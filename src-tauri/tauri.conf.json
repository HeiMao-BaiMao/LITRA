{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LITRA",
  "version": "2.1.1",
  "identifier": "org.hmbm.litra",
  "build": {
    "beforeDevCommand": "trunk serve --port 1420 --no-sri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LITRA",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "license": "BSD-2-Clause",
    "licenseFile": "../LICENSE.rtf",
    "resources": {
      "../legal/THIRD_PARTY_LICENSES.json": "legal/THIRD_PARTY_LICENSES.json",
      "../legal/THIRD_PARTY_LICENSES.md": "legal/THIRD_PARTY_LICENSES.md",
      "../config/default-providers.json": "config/default-providers.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/HeiMao-BaiMao/LITRA/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
